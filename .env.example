# ============================================================================
# UniPrep — Environment Variables Template
# ============================================================================
# Copy this file to `.env.local` and fill in your Supabase project values
# when connecting a real project in Phase 2+.
#
# SECURITY:
# - Never commit `.env.local` or real credentials to version control.
# - Never expose `SUPABASE_SECRET_KEY` or `SUPABASE_SERVICE_ROLE_KEY` to
#   browser/client code (never prefix them with `NEXT_PUBLIC_`).
# ============================================================================

# 1. Supabase Project URL (public, safe for browser & server)
# Example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 2. Supabase Publishable / Anon Key (public, safe for browser & server with RLS)
# Preferred variable name:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
# Legacy fallback (optional if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY is set):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Supabase Secret / Service Role Key (SERVER-ONLY — bypasses RLS, never expose to client)
# Preferred variable name:
SUPABASE_SECRET_KEY=
# Legacy fallback (optional if SUPABASE_SECRET_KEY is set):
SUPABASE_SERVICE_ROLE_KEY=
